{
  "name": "dsh-moki-library",
  "version": "0.1.62",
  "type": "module",
  "description": "MOKI Library for DSH: local file management, rich previews, Office editing and precise AI selection collaboration.",
  "author": "MOKI",
  "exports": {
    ".": "./lib/host.mjs",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "app",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-file-drag",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@fastify/static": "10.1.2",
    "@puppeteer/browsers": "3.2.6",
    "7zip-bin": "5.2.0",
    "ag-psd": "34.1.0",
    "dsh-univer-office": "0.2.10",
    "fastify": "5.10.0",
    "fflate": "0.8.2",
    "parse5": "8.0.0",
    "puppeteer-core": "25.16.0",
    "sharp": "0.35.5",
    "unpdf": "1.8.1",
    "word-extractor": "1.0.4",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.8",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.8",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.8",
    "@extend-ai/react-pptx": "0.1.2",
    "@sharp9/ofdjs": "0.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.14.26",
    "@vitejs/plugin-react": "6.0.4",
    "esbuild": "0.28.1",
    "lucide-react": "1.25.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "three": "0.187.0",
    "vite": "8.1.5"
  },
  "license": "MIT",
  "homepage": "https://github.com/JKZeng-cell/moki-library-for-dsh#readme",
  "repository": {
    "url": "https://github.com/JKZeng-cell/moki-library-for-dsh.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/JKZeng-cell/moki-library-for-dsh/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "moki",
    "file-manager",
    "document-management",
    "local-first",
    "ai-collaboration",
    "document-preview",
    "office-editor",
    "pdf",
    "spreadsheet",
    "productivity"
  ]
}
